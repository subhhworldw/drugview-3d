# Copy to .env and fill in your own values. Never commit the real .env.
# Server-side (used by server functions / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Client-side (safe to expose in the browser bundle — publishable keys only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or in the repo.
# Secret values are stored in the hosting platform's secret manager only.
