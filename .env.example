# Copy to .env and fill in your own values. Never commit the real .env.

# Server-side (used by server functions / SSR)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Client-side (safe to expose in the browser bundle — publishable keys only)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in this file or in
# the repo. Secret values live only in the hosting platform's secret manager.
